zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' # don't actually really know
zstyle ':completion:*' menu select                        # have the selection menu highlight
zstyle ':completion:*' _expand _complete _ignored         # better =command behaviour

# nicer completion behaviour
zmodload -i zsh/complist
bindkey -M menuselect '^e' send-break   # cancel completion
bindkey -M menuselect '^M' .accept-line # accept highlighted completion immediately

setopt globdots # also match files with `.` at start
