# shellcheck source=/dev/null

# bindkey -e # will be emacs mode
bindkey -v
export KEYTIMEOUT=11

# Still use emac power
bindkey "^A" beginning-of-line
bindkey "^E" end-of-line
bindkey "^K" kill-line
bindkey "^L" clear-screen
bindkey "^P" up-line-or-beginning-search
bindkey "^N" down-line-or-beginning-search
bindkey "^U" kill-whole-line
bindkey "^W" backward-kill-word
bindkey "^Y" yank
bindkey "^F" forward-char
bindkey "^ " forward-word
bindkey "^B" backward-char

# Let surround work
autoload -Uz surround
zle -N delete-surround surround
zle -N add-surround surround
zle -N change-surround surround
bindkey -a sr change-surround
bindkey -a sd delete-surround
bindkey -a sa add-surround
bindkey -M visual S add-surround

bindkey -M viins 'jk' vi-cmd-mode # type jk quickly to get into command mode

# Change cursor shape for different vi modes.
# shellcheck disable=all # following line uses zsh syntax
function zle-keymap-select () {
if [[ $ZLE_STATE == *overwrite* ]] && [[ $KEYMAP == (viins|main) ]]; then
        echo -ne '\e[2 q' # block
    elif [[ $KEYMAP == vicmd ]]; then
        echo -ne '\e[4 q' #underline
    elif [[ $KEYMAP == (viins|main) ]]; then
        echo -ne '\e[6 q'
    fi
}

# But replace just refuses to work though
function vi-replace-character() {
  echo -ne '\e[2 q' # block
  zle vi-replace-chars
  echo -ne '\e[4 q' #underline
}
zle -N vi-replace-character
bindkey -M vicmd 'r' vi-replace-character

zle -N zle-keymap-select
zle-line-init() {
  zle -K viins # initiate `vi insert` as keymap (can be removed if `bindkey -V` has been set elsewhere)
  echo -ne "\e[6 q"
}
zle -N zle-line-init
echo -ne '\e[6 q'                # Use beam shape cursor on startup.
preexec() { echo -ne '\e[6 q'; } # Use beam shape cursor for each new prompt.

## scrolling keybinds
autoload -U up-line-or-beginning-search
autoload -U down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
