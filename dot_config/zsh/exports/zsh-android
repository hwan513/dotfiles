# Android ENV variables
export ANDROID_HOME="$HOME/Library/Android/sdk" # if have android studio
# export ANDROID_HOME="$HOMEBREW_PREFIX/share/android-commandlinetools" # if installing via brew
export PATH=$ANDROID_HOME/cmdline-tools/tools/bin:"$ANDROID_HOME"/emulator:"$ANDROID_HOME"/platform-tools:$PATH
export NDK_HOME="$ANDROID_HOME"/ndk/$(_cachecommand ndk /bin/ls -1 "$ANDROID_HOME"/ndk)
