#!/bin/bash
# Run this script to setup the config on a local machine

# Install Homebrew packages with sudo permissions
sudo -v
brew bundle --file Brewlite

# Set the global gitignore
git config --global core.excludesfile ~/.gitignore_apple

# Link dotfiles to the home directory
stow .

# Install mise dependencies
# mise install # disabled for lite installation

# Setup hammmerspoon
curl -L https://github.com/Hammerspoon/Spoons/raw/master/Spoons/SpoonInstall.spoon.zip -o SpoonInstall.spoon.zip
unzip SpoonInstall.spoon.zip -d .hammerspoon/Spoons
rm SpoonInstall.spoon.zip

# Restart shell instance
exec zsh
