# Set of tool profiles enabled on this machine.
# Used to conditionally source zsh exports in dot_config/zsh/dot_zshrc.tmpl.
# Valid values: "android", "rust", "orbstack"
[data]
profiles = []
# Shell used on this machine.
# Controls which shell config is applied (see .chezmoiignore).
# Valid values: "fish", "zsh". Defaults to "fish".
shell = "fish"
