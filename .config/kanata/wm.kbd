(defalias
  fcsl M-S-A-left
  fcsr M-S-A-right
  fcsu M-S-A-up
  fcsd M-S-A-down

  fcs0 M-S-A-0
  fcs1 M-S-A-1
  fcs2 M-S-A-2
  fcs3 M-S-A-3
  fcs4 M-S-A-4
  fcs5 M-S-A-5
  fcs6 M-S-A-6
  fcs7 M-S-A-7
  fcs8 M-S-A-8
  fcs9 M-S-A-9

  flsc M-S-A-f

  rsz- M-S-A--
  rsz= M-S-A-=

  tile M-S-A-/
  acco M-S-A-,

  swch M-S-A-tab
  clsa M-S-A-bspc

)

(deflayer wm
  _     _     _     _     _     _     _     _     _     _     _     _     _     _
  @fcs0 @fcs1 @fcs2 @fcs3 @fcs4 @fcs5 @fcs6 @fcs7 @fcs8 @fcs9 @fcs0 _     _     @clsa _
  @swch @rsz- @fcsu @rsz= _     _     _     @rsz- @fcsu @rsz= _     _     _     _     _   
  @flsc @fcsl @fcsd @fcsr _     _     _     @fcsl @fcsd @fcsr _     _     _           _    
  @wm   @tile @acco _     _     _     _     _     _     @acco @tile @wm         @fcsu 
  _     _     _     _             lctl            _     _     _     _     @fcsl @fcsd @fcsr
)
