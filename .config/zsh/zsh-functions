# shellcheck source=/dev/null
# Adapted from https://github.com/Mach-OS/Machfiles/blob/master/zsh/.config/zsh/zsh-functions

# Function to source files if they exist
function _zsh_add_file() {
  [ -f "$ZDOTDIR/$1" ] && source "$ZDOTDIR/$1"
}

# Adapted from code from https://github.com/QuarticCat/zsh-smartcache and https://github.com/mroth/evalcache
# Directory to store cache files
ZSH_CACHEVAL_DIR=${ZSH_CACHEVAL_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/zsh-cacheval}

# Supply commmand to eval as a string
mkdir -p "$ZSH_CACHEVAL_DIR"
function _cacheval() {
  local cache_file="$ZSH_CACHEVAL_DIR"/"$1".zsh
  _cachewrite "$cache_file" "${@:2}"
  source "$cache_file"
}

# Caches the output of the command and returns it, currently only accounts for single strings
function _cachecommand() {
  local cache_file="$ZSH_CACHEVAL_DIR"/"$1".zsh
  _cachewrite "$cache_file" "${@:2}"
  echo "$(<"$cache_file")"
}

function _cachewrite() {
  (($# < 2)) && printf "Incorrect cache[val|command] usage for '%s'\nUsage: cache[val|command] <cache-key> <command>" "$1" && return 1
  local cache_file="$1"
  if [ ! -f "$cache_file" ]; then
    echo "Caching output for ${*:2}"
    # Can't seem to get piping from file to file to work for better handling
    "${@:2}" >"$cache_file" &&
      _cachepropagate "$cache_file" &&
      zcompile "$cache_file"
  fi
}

function cacheclear() {
  find "${ZSH_CACHEVAL_DIR:?}" -type f -delete
}

# shellcheck disable=SC2016,SC2001
function _cachepropagate() {
  input_file=$1
  calculate_md5() {
    echo -n "$1" | md5
  }
  touch "$input_file.temp"
  # Read the input file line by line
  while IFS= read -r line; do
    # Check if the line contains 'eval "$(operation)"'
    if echo "$line" | grep -q "^\s*eval \"\$\(.*\)\""; then
      operation=$(echo "$line" | sed -n 's/eval "\$(\(.*\))"/\1/p')
      md5=$(calculate_md5 "$operation")
      # Replace 'eval "$(operation)"' with '_cacheval $md5 $operation'
      line=$(echo "$line" | sed -r 's/eval "\$\((.*)\)";?/_cacheval '"$md5"' \1/')
    fi
    # Write the modified line to the output file
    echo -E "$line" >>"$input_file.temp"
  done <"$input_file"
  mv "$1.temp" "$1"
}
