# aliases for better commands in general
alias mkdir='nocorrect mkdir'
alias ls='lsd'

# alias for the maven compiler
alias mco='mvn compile'
alias mcl='mvn clean'
alias mte='mvn test'
alias mcc='mvn clean compile'
alias mct='mvn clean test'
alias mej='mvn exec:java'
alias mjr='mvn clean javafx:run'
alias mfc='mvn git-code-format:format-code'

# alias for git
alias gta='git add'
alias gtc='git commit -m'
alias gtl='git log'
alias gtp='git push'
alias gts='git status'
alias gco='git checkout'
alias gcb='git checkout -b'
alias gtb='git branch'
alias gst='git stash'
alias gsp='git stash pop'
alias gitprune='git branch --merged main | grep -v "^\* main" | xargs -n 1 -r git branch -d'

# alias for cargo
alias crr="cargo run --release"
alias crd="cargo run"
alias ccl="cargo clean"
alias cbu="cargo build"
alias cte="cargo test"

# rosetta version of homebrew
alias ibrew="arch -x86_64 /usr/local/bin/brew"
alias idotnet="arch -x86_64 /usr/local/bin/dotnet"
alias ipipx="arch -x86_64 /usr/local/bin/pipx"

alias n="nvim"
_cacheval fuck thefuck --alias
alias f='fuck'
alias j='just'
alias .j='just --justfile ~/.config/just/justfile --working-directory .'

alias jjj='lazyjj'
alias jl='jj log'
alias jd='jj describe'
alias jn='jj new'
alias je='jj edit'
alias ja='jj abandon'
alias js='jj squash'
alias jb="jj log -r 'heads(all())'"
alias jp='jj git push'
alias jf='jj git fetch'
alias jll="jj log -r .."
# alias jll="jj log -r '@ | ancestors(remote_bookmarks().., 2) | trunk()'"
alias jlll='jj log -r .. --reversed'
